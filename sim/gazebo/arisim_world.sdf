<?xml version="1.0" ?>
<!--
  Display-only world for arisim (python3 -m arisim fly --gazebo).
  arisim computes the physics and the sensors and drives the flight controller (SIL or PIL);
  sim/gazebo/gz_relay.py places the quad here at about 60 Hz and spins the props.
  The quad has no gravity and no collisions, so Gazebo's own physics never moves it.
  Terrain boxes from the scenario are created at startup.
-->
<sdf version="1.9">
  <world name="arisim">
    <physics name="display" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <!-- Window: the 3D view only, camera behind the quad (gz_relay asks it to follow) -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.75 0.82 0.9</background_color>
        <camera_pose>-4 -3 2.5 0 0.35 0.6</camera_pose>
        <camera_clip><near>0.05</near><far>300</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.82 0.9 1</background>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.45 0.5 0.45 1</ambient><diffuse>0.45 0.5 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="x3">
      <pose>0 0 0.05 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>0.5</mass><inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="body"><geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/tip/files/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="nose">
          <pose>0.12 0 0 0 0 0</pose>
          <geometry><sphere><radius>0.015</radius></sphere></geometry>
          <material><ambient>1 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="rotor_0">
        <pose>0.13 -0.22 0.023 0 0 0</pose>
        <gravity>false</gravity>
        <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
        <visual name="v0"><geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/tip/files/meshes/propeller_ccw.dae</uri><scale>0.1 0.1 0.1</scale></mesh></geometry></visual>
      </link>
      <link name="rotor_1">
        <pose>-0.13 0.22 0.023 0 0 0</pose>
        <gravity>false</gravity>
        <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
        <visual name="v1"><geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/tip/files/meshes/propeller_ccw.dae</uri><scale>0.1 0.1 0.1</scale></mesh></geometry></visual>
      </link>
      <link name="rotor_2">
        <pose>0.13 0.22 0.023 0 0 0</pose>
        <gravity>false</gravity>
        <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
        <visual name="v2"><geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/tip/files/meshes/propeller_cw.dae</uri><scale>0.1 0.1 0.1</scale></mesh></geometry></visual>
      </link>
      <link name="rotor_3">
        <pose>-0.13 -0.22 0.023 0 0 0</pose>
        <gravity>false</gravity>
        <inertial><mass>0.001</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia></inertial>
        <visual name="v3"><geometry><mesh><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/tip/files/meshes/propeller_cw.dae</uri><scale>0.1 0.1 0.1</scale></mesh></geometry></visual>
      </link>
      <joint name="j0" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="j1" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="j2" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz></axis></joint>
      <joint name="j3" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz></axis></joint>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>j0</joint_name></plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>j1</joint_name></plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>j2</joint_name></plugin>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController"><joint_name>j3</joint_name></plugin>
    </model>
  </world>
</sdf>
